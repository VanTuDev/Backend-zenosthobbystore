# --- Server ---
PORT=4000
NODE_ENV=development
# Frontend origin allowed to call this API with credentials
CORS_ORIGIN=http://localhost:3000

# --- Database (MongoDB Atlas) ---
# Leave empty until the Atlas connection string is issued — the server still
# boots and public/static routes work; anything touching the DB returns 503
# with a clear message until this is filled in.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>?retryWrites=true&w=majority
MONGODB_URI=

# --- Auth ---
# Secret used to sign session JWTs — change this in production.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# --- Google OAuth ---
# Fill these in once Google Cloud credentials are issued.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly in the Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# Where to send the browser after login succeeds/fails.
FRONTEND_LOGIN_SUCCESS_URL=http://localhost:3000
FRONTEND_LOGIN_FAILURE_URL=http://localhost:3000?login=failed

# --- Dev-only login bypass ---
# When true, POST /auth/dev-login lets you log in as any email without real
# Google credentials — for local development before GOOGLE_CLIENT_ID/SECRET
# are issued. Never enable in production.
ALLOW_DEV_LOGIN=true

# --- Cloudinary (product image uploads) ---
# All three required — from the Cloudinary dashboard (Settings > API Keys).
# Upload routes (POST/DELETE /uploads/image) 503 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
