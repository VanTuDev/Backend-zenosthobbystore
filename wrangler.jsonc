{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers entry for the ZENOST backend (separate from the Node entry src/index.ts,
  // which Render / local dev still use).
  "name": "zenost-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  // nodejs_compat: node:http/net/tls etc. (Express + MongoDB driver need them).
  // nodejs_compat_populate_process_env: bindings (vars + secrets) show up on process.env, which
  // src/config/env.ts reads — so no code change is needed there.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "workers_dev": true,
  // body-parser -> raw-body -> iconv-lite breaks under workerd; see the shim for why.
  "alias": { "iconv-lite": "./src/shims/iconv-lite.cjs", "mongoose": "./node_modules/mongoose/index.js" },
  "observability": { "enabled": true },
  // Non-secret config. Secrets (MONGODB_URI, JWT_SECRET, GOOGLE_CLIENT_SECRET, CLOUDINARY_API_SECRET,
  // CLOUDINARY_API_KEY) are set with `wrangler secret put`, never written here.
  "vars": {
    "NODE_ENV": "production",
    "PORT": "8080",
    "ALLOW_DEV_LOGIN": "false",
    "JWT_EXPIRES_IN": "7d",
    "CORS_ORIGIN": "https://zenosthobbystore.com,https://zenosthobbystore.vercel.app",
    "FRONTEND_LOGIN_SUCCESS_URL": "https://zenosthobbystore.com",
    "FRONTEND_LOGIN_FAILURE_URL": "https://zenosthobbystore.com?login=failed",
    "GOOGLE_CLIENT_ID": "26621147076-hfpg29e0m0se75h25k23bscandfanelt.apps.googleusercontent.com",
    "GOOGLE_REDIRECT_URI": "https://zenost-backend.vantu-dev.workers.dev/auth/google/callback",
    "CLOUDINARY_CLOUD_NAME": "hanb7egm"
  }
}
